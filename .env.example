# 本番では HTTPS のとき 1（既定）。社内HTTPで動かすときだけ 0。
COOKIE_SECURE=1

# 両方あるときだけ Turso。無いときは data/gluck.sqlite を使う。
# TURSO_DATABASE_URL=libsql://xxxx.turso.io
# TURSO_AUTH_TOKEN=

# 外部から同期を呼ぶときの秘密。URLには書かない。
# CRON_SECRET=

# 利用者が1人もいないときだけ、このメールとパスワードで管理者を1人作る。
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=

# 本物のシートを読むときだけ。JSONファイルの中身を1行で。
# GOOGLE_SERVICE_ACCOUNT_JSON=
